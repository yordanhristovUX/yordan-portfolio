# Generated artefacts are committed, so their bytes must not depend on the OS
# that produced them. Without this, a Windows run of design-system/scripts/build.mjs
# or scripts/build-content.mjs rewrites dist/ and the generated pages with CRLF and
# every generator run dirties the tree with an empty content diff — which also makes
# `--check` unreliable, since it compares generated bytes against what is on disk.
#
# LF everywhere, in the repo AND in the working tree.
* text=auto eol=lf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
