{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://yordan-portfolio.vercel.app/#person","name":"Yordan Hristov","jobTitle":"Senior Product Designer","description":"I build AI-ready design systems: component libraries with 1:1 parity between Figma and code, plus custom Claude skills and MCP setups that let agents assemble UI from the real system without drift. I write and ship the frontend myself, reviewed and merged by engineering. Under the tooling sits seven years of research practice — user interviews, usability testing, and WCAG 2.1 AA auditing.","email":"mailto:yhristov.xyz@gmail.com","telephone":"+359 884 614 579","url":"https://yordan-portfolio.vercel.app","address":{"@type":"PostalAddress","addressLocality":"Sofia","addressCountry":"Bulgaria"},"sameAs":["https://www.linkedin.com/in/yordan-hristov/","https://github.com/yordanhristovUX/yordan-portfolio"],"knowsAbout":["AI workflows","Design systems","Research","Product design","Engineering"],"alumniOf":[{"@type":"EducationalOrganization","name":"Telerik Academy"},{"@type":"EducationalOrganization","name":"Software University (SoftUni)"},{"@type":"EducationalOrganization","name":"Sofia University"}],"knowsLanguage":[{"@type":"Language","name":"Bulgarian"},{"@type":"Language","name":"English"}],"worksFor":{"@type":"Organization","name":"Green Street"}},{"@type":"CreativeWork","@id":"https://yordan-portfolio.vercel.app/#greenstreet-ds","name":"AI-Ready Design System","headline":"Green Street — AI-Ready Design System","abstract":"Infrastructure that lets AI generate production-faithful UI: 1:1 Figma-to-code parity, custom Claude skills, and a prototype pipeline for the whole TPM team.","description":"~35 components at 1:1 Figma-to-code parity, 100% token coverage, custom Claude skills, and a prototype pipeline the whole TPM team uses. Production navigation shipped.","keywords":["Senior Product Designer","Design Systems","AI Workflows","Figma-to-code","WCAG","Production code"],"creator":{"@id":"https://yordan-portfolio.vercel.app/#person"}},{"@type":"CreativeWork","@id":"https://yordan-portfolio.vercel.app/#greenstreet-audit","name":"UX & Accessibility Audits","headline":"Green Street — UX & Accessibility Audits","abstract":"End-to-end WCAG 2.1 AA audits of two distinct product surfaces — an editorial platform and a data-dense analytics platform — with severity-rated, annotated remediation roadmaps.","description":"WCAG 2.1 AA audits of two product surfaces — editorial and data-dense analytics. 200+ issue instances catalogued with severity ratings and a prioritised remediation roadmap.","keywords":["Senior Product Designer","Accessibility","UX Audit","WCAG 2.1 AA","Two products"],"creator":{"@id":"https://yordan-portfolio.vercel.app/#person"}},{"@type":"CreativeWork","@id":"https://yordan-portfolio.vercel.app/#malko-tarnovo","name":"Municipal Mobile App","headline":"Municipality of Malko Tarnovo — Municipal Mobile App","abstract":"End-to-end design of a cross-platform civic app serving two opposing audiences — tourists and older residents — live on the App Store and Google Play.","description":"Civic app serving tourists and older residents at once. White-label token system. Live on the App Store and Google Play.","keywords":["Product Designer","Shipped","Design System","iOS & Android","White-label","Accessibility"],"creator":{"@id":"https://yordan-portfolio.vercel.app/#person"}},{"@type":"CreativeWork","@id":"https://yordan-portfolio.vercel.app/#domestina","name":"Cleaning Service Marketplace","headline":"Domestina.bg — Cleaning Service Marketplace","abstract":"A research-led, multi-year UX engagement on Bulgaria's leading cleaning services marketplace — every design change grounded in evidence, not assumption.","description":"Multi-year, research-led UX. Front page, flows, onboarding, loyalty — bounce rate down 40%, retention up.","keywords":["UX Researcher & Designer","UX Research","Data-driven","Marketplace","Multi-year"],"creator":{"@id":"https://yordan-portfolio.vercel.app/#person"}},{"@type":"CreativeWork","@id":"https://yordan-portfolio.vercel.app/#spetema","name":"Product & Corporate Website","headline":"Spetema Coffee — Product & Corporate Website","abstract":"A 200+ product coffee catalogue reconciling B2C e-commerce and B2B corporate needs on a single coherent site — with a bold visual system and purposeful motion. Bilingual, live.","description":"A 200+ product coffee catalogue serving households and businesses from one site. Split navigation, a preparation-method finder, eight sub-brands on a shared attribute model. Bilingual, live.","keywords":["Product Designer","Information Architecture","Motion design","B2C + B2B","Live"],"creator":{"@id":"https://yordan-portfolio.vercel.app/#person"}},{"@type":"CreativeWork","@id":"https://yordan-portfolio.vercel.app/#portfolio-system","name":"Portfolio as a Product","headline":"This site — Portfolio as a Product","abstract":"The site you are reading runs on its own AI-ready, repo-first design system — open source, rendered in Storybook, pushed to Figma, deployed on every commit. The portfolio is the case study.","description":"An AI-ready design system that ships itself: repo-first tokens, Storybook, one-way Figma push, auto-deploys — all open source.","keywords":["Designer & Builder","Design system","AI-first","Storybook","Figma push","Open source"],"creator":{"@id":"https://yordan-portfolio.vercel.app/#person"}}]}
